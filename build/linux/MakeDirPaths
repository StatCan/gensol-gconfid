$(info DIR_PYTHON_BIN                  = $(DIR_PYTHON_BIN))
$(info DIR_TEST_LOW_LEVEL              = $(DIR_TEST_LOW_LEVEL))
$(info INIT_DIR_PATH                   = $(INIT_DIR_PATH))